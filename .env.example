# Configure apenas as chaves públicas de um projeto Supabase.
# As duas migrations em supabase/migrations precisam ser aplicadas antes de usar o Casa Nexo.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUBSTITUA

# Projetos legados também podem usar VITE_SUPABASE_ANON_KEY em vez de PUBLISHABLE_KEY.
# NUNCA coloque SUPABASE_SERVICE_ROLE_KEY, senha ou chave de IA no Vite.
